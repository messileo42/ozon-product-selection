{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated 1688 browser evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "captured_at",
    "access_mode",
    "canonical_offer_url",
    "offer_id",
    "page_title",
    "page_text"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "const": "codex_attached_browser" },
    "captured_at": { "type": "string", "format": "date-time" },
    "access_mode": { "enum": ["authenticated", "anonymous"] },
    "canonical_offer_url": {
      "type": "string",
      "pattern": "^https://detail\\.1688\\.com/offer/[0-9]+\\.html$"
    },
    "offer_id": { "type": "string", "pattern": "^[0-9]+$" },
    "page_title": { "type": "string", "minLength": 1 },
    "page_text": { "type": "string", "minLength": 80 },
    "capture_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
